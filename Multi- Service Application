6. Our app.js file
This is the application code we verified inside the running container.
const http = require('http');
const redis = require('redis');

async function startApp() {
    const redisClient = redis.createClient({
        url: 'redis://redis:6379'
    });

    redisClient.on('error', (err) => {
        console.error('Redis error:', err);
    });

    await redisClient.connect();

    const app = http.createServer(async (req, res) => {
        try {
            const visits = await redisClient.incr('visits');

            res.writeHead(200, { 'Content-Type': 'text/html' });
            res.end(`<h1>Hello from KELY!</h1><p>Visits: ${visits}</p>`);
        } catch (err) {
            console.error('Request error:', err);
            res.writeHead(500);
            res.end('Something went wrong');
        }
    });

    app.listen(3000, '0.0.0.0', () => {
        console.log('App running on port 3000');
    });
}

startApp().catch((err) => {
    console.error('App failed to start:', err);
    process.exit(1);
});


What we learned from this code
- http creates the web server.
- redis.createClient() creates the Redis connection.
- redis://redis:6379 uses the Compose service name redis to reach Redis over the Compose network.
- redisClient.incr('visits') increments the visit counter.
- app.listen(3000, '0.0.0.0') makes the server listen on all interfaces inside its container.
- The error handlers help us diagnose connection or request failures.

